# EZTruckr — production reverse proxy.
#
# ONE HOSTNAME SERVES BOTH APPS, and that is the whole design. `/api/*` goes to
# NestJS, everything else to Next.js, so the browser only ever talks to a
# single origin.
#
# WHY THAT MATTERS more than it looks. The four URL settings that .env.example
# warns "must all change together" — APP_BASE_URL, CORS_ORIGINS,
# BETTER_AUTH_URL, NEXT_PUBLIC_API_URL — all collapse to the same value here.
# The session cookie is first-party, so it is immune to third-party cookie
# blocking in Safari and Chrome; CORS never engages, because nothing is cross
# origin; and there is no second certificate or DNS record to keep alive.
#
# Splitting the API onto api.eztruckr.* would undo all of that and buy nothing:
# both processes are on this one droplet either way.
#
# The API's global prefix is already `/api` (see main.ts), and the web app has
# no route handlers or middleware of its own, so the split is unambiguous —
# no path rewriting happens or should.
{
	# Nothing on this box should be reconfiguring Caddy over HTTP.
	admin off
}

{$APP_DOMAIN} {
	# Cloudflare Origin Certificate. Trusted by Cloudflare and nobody else,
	# which is correct: the only client that should reach this origin is
	# Cloudflare, and the DNS record is proxied so it is the only one that can.
	# Cloudflare's SSL/TLS mode must be "Full (strict)" for it to be verified.
	#
	# Valid 15 years, so there is no renewal to automate or forget.
	#
	# FALLBACK, if you ever turn the orange cloud off: delete this line. Caddy
	# then provisions a real Let's Encrypt certificate over HTTP-01 by itself,
	# with no other change — but that only works while the record is DNS-only,
	# because a proxied record answers the challenge with Cloudflare's IP.
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	header {
		# Cloudflare passes these through to the browser untouched.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The stack advertising its own name to attackers helps nobody.
		-Server
	}

	# Slightly above the app's own 10 MB receipt cap (MAX_RECEIPT_BYTES), on
	# purpose. An oversized upload should be refused by the API, which explains
	# in Tagalog-office English how big the file was and what the limit is —
	# not by a bare 413 from the proxy with no body.
	request_body {
		max_size 12MB
	}

	# NestJS. Covers /api/auth too, which Better Auth mounts under the same
	# prefix, so sessions ride the same origin as everything else.
	handle /api/* {
		reverse_proxy api:4000
	}

	# Next.js standalone server: pages, static assets, everything else.
	handle {
		reverse_proxy web:3000
	}
}
