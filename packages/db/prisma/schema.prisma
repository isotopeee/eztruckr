// EZTruckr data model — complete domain schema.
//
// MONEY RULES (columns here, arithmetic in @eztruckr/types/money):
//   - Money       -> Decimal @db.Decimal(15, 4). Never Float.
//   - Percentages -> Decimal @db.Decimal(5, 4)  (0.2500 = 25%).
//   - Reads convert via `value.toString()` into currency.js. Never `.toNumber()`.
//   - Non-money numerics (distance, capacity) are called out where they occur.
//
// ENUMERATED VALUES: stored as Int @db.SmallInt. There are deliberately NO
//   `enum` blocks here and no native Postgres enum types. Every code set is
//   declared once in @eztruckr/types/codes and imported by both the API and
//   the web app; a bare numeric literal should appear nowhere else.
//   Codes are permanent — never renumbered, never reused, appended only.
//   Each code column carries a CHECK constraint (added by migration) so a bad
//   write fails at the database instead of becoming an unreadable row, and a
//   SQL COMMENT so someone reading raw SQL can decode it.
//
// AUDIT RULES:
//   Every business table carries createdAt / updatedAt / createdBy / updatedBy.
//   `createdBy` / `updatedBy` / `deletedBy` are FK columns referencing User.id,
//   exposed as `createdByUser` / `updatedByUser` / `deletedByUser`. The scalars
//   keep their plain names so the audit column set reads as specified and the
//   stamping extension can write them without relation syntax.
//   Stamped exclusively by src/audit-extension.ts, never from a request body.
//   `updatedBy` stays null until the row is first modified.
//
//   `createdBy` is declared OPTIONAL here but is NOT optional in the domain.
//   The extension supplies it at query time, which the generated TypeScript
//   cannot see, so a required column would make every create() in the codebase
//   demand a value the caller must never provide. Instead the column is
//   nullable to Prisma and mandatory in Postgres, via
//   `<table>_created_by_required` CHECK constraints. Prisma's differ ignores
//   CHECK constraints, so this produces no drift. `user` and `user_profile`
//   are genuinely exempt — bootstrap admin and self-registration.
//
// SOFT DELETE:
//   Every business table has nullable deletedAt / deletedBy. Rows are NEVER
//   hard-deleted. Reads are filtered in exactly one place — the client
//   extension in src/soft-delete-extension.ts adds `deletedAt: null` to every
//   query, including nested relation reads, with an explicit opt-in for the
//   admin "view deleted" and restore paths.
//
//   `isActive` is a SEPARATE concept and is not collapsed into deletion:
//     isActive = false -> still valid on history, not offered for new entries
//                         (a sold truck, a departed crew member)
//     deletedAt set    -> removed from use entirely
//
//   Unique constraints on these tables are PARTIAL (WHERE "deletedAt" IS NULL),
//   added by migration, so a deleted row does not reserve its code or
//   reference number forever. Prisma cannot express partial uniqueness, which
//   is why those columns carry no `@unique` here.
//
//   ONE DELIBERATE EXCEPTION: commission."payoutLineId" is a FULL unique index.
//   A soft-deleted commission must still count as paid, so deleting it must
//   never release its payout line and make it payable again.
//
//   Foreign keys stay intact: soft-deleting a parent does not cascade, because
//   children must remain readable for history.
//
// TIMESTAMPS: DateTime is `timestamptz`, stored UTC, rendered Asia/Manila at
//   the edges only.
//
// FREEZING: anything named applied* is a value copied at computation time.
//   Later edits to SystemSetting or CommissionRule must never move it.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Partial-unique on (email) WHERE "deletedAt" IS NULL.
  email         String
  name          String
  emailVerified Boolean @default(false)

  /// Code set: UserRole (1 ADMINISTRATOR, 2 OPERATIONS, 3 ACCOUNTING,
  /// 4 MANAGEMENT, 5 CREW). Never ranked — check membership, never `<`.
  role Int @default(5) @db.SmallInt

  isActive Boolean @default(true)

  /// Set only for role = CREW. The hard link that scopes a portal user to
  /// exactly one staff member's records; every crew-facing query filters on it.
  /// An office login has none — a dispatch manager is a `staff` row and signs
  /// in as OPERATIONS, which is not scoped to one person's records.
  /// Partial-unique WHERE "deletedAt" IS NULL.
  staffId String? @db.Uuid
  staff   Staff?  @relation("StaffLogin", fields: [staffId], references: [id], onDelete: SetNull)

  /// At most one live profile, enforced by a partial unique index.
  profiles UserProfile[] @relation("UserProfileOwner")

  // Better Auth infrastructure.
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  /// Every invite ever issued for this login, newest last. At most one is
  /// pending at a time, enforced by a partial unique index.
  invitations StaffInvitation[] @relation("StaffInvitationUser")

  lastLoginAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Nullable on User alone: the bootstrap administrator has no creator, and a
  /// self-registering user has no acting user either.
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("UserDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  usersCreated User[] @relation("UserCreatedBy")
  usersUpdated User[] @relation("UserUpdatedBy")
  usersDeleted User[] @relation("UserDeletedBy")

  // --- audit back-relations (created / updated / deleted per table) -------
  userProfilesCreated UserProfile[] @relation("UserProfileCreatedBy")
  userProfilesUpdated UserProfile[] @relation("UserProfileUpdatedBy")
  userProfilesDeleted UserProfile[] @relation("UserProfileDeletedBy")

  staffInvitationsCreated StaffInvitation[] @relation("StaffInvitationCreatedBy")
  staffInvitationsUpdated StaffInvitation[] @relation("StaffInvitationUpdatedBy")
  staffInvitationsDeleted StaffInvitation[] @relation("StaffInvitationDeletedBy")

  trucksCreated Truck[] @relation("TruckCreatedBy")
  trucksUpdated Truck[] @relation("TruckUpdatedBy")
  trucksDeleted Truck[] @relation("TruckDeletedBy")

  staffCreated Staff[] @relation("StaffCreatedBy")
  staffUpdated Staff[] @relation("StaffUpdatedBy")
  staffDeleted Staff[] @relation("StaffDeletedBy")

  clientsCreated Client[] @relation("ClientCreatedBy")
  clientsUpdated Client[] @relation("ClientUpdatedBy")
  clientsDeleted Client[] @relation("ClientDeletedBy")

  thirdPartiesCreated ThirdParty[] @relation("ThirdPartyCreatedBy")
  thirdPartiesUpdated ThirdParty[] @relation("ThirdPartyUpdatedBy")
  thirdPartiesDeleted ThirdParty[] @relation("ThirdPartyDeletedBy")

  payeesCreated Payee[] @relation("PayeeCreatedBy")
  payeesUpdated Payee[] @relation("PayeeUpdatedBy")
  payeesDeleted Payee[] @relation("PayeeDeletedBy")

  routesCreated Route[] @relation("RouteCreatedBy")
  routesUpdated Route[] @relation("RouteUpdatedBy")
  routesDeleted Route[] @relation("RouteDeletedBy")

  expenseCategoriesCreated ExpenseCategory[] @relation("ExpenseCategoryCreatedBy")
  expenseCategoriesUpdated ExpenseCategory[] @relation("ExpenseCategoryUpdatedBy")
  expenseCategoriesDeleted ExpenseCategory[] @relation("ExpenseCategoryDeletedBy")

  commissionRulesCreated CommissionRule[] @relation("CommissionRuleCreatedBy")
  commissionRulesUpdated CommissionRule[] @relation("CommissionRuleUpdatedBy")
  commissionRulesDeleted CommissionRule[] @relation("CommissionRuleDeletedBy")

  systemSettingsCreated SystemSetting[] @relation("SystemSettingCreatedBy")
  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")
  systemSettingsDeleted SystemSetting[] @relation("SystemSettingDeletedBy")

  shipmentsCreated Shipment[] @relation("ShipmentCreatedBy")
  shipmentsUpdated Shipment[] @relation("ShipmentUpdatedBy")
  shipmentsDeleted Shipment[] @relation("ShipmentDeletedBy")

  allowancesCreated Allowance[] @relation("AllowanceCreatedBy")
  allowancesUpdated Allowance[] @relation("AllowanceUpdatedBy")
  allowancesDeleted Allowance[] @relation("AllowanceDeletedBy")

  liquidationsCreated Liquidation[] @relation("LiquidationCreatedBy")
  liquidationsUpdated Liquidation[] @relation("LiquidationUpdatedBy")
  liquidationsDeleted Liquidation[] @relation("LiquidationDeletedBy")

  liquidationLinesCreated LiquidationLine[] @relation("LiquidationLineCreatedBy")
  liquidationLinesUpdated LiquidationLine[] @relation("LiquidationLineUpdatedBy")
  liquidationLinesDeleted LiquidationLine[] @relation("LiquidationLineDeletedBy")

  liquidationHistoryCreated LiquidationHistory[] @relation("LiquidationHistoryCreatedBy")
  liquidationHistoryUpdated LiquidationHistory[] @relation("LiquidationHistoryUpdatedBy")
  liquidationHistoryDeleted LiquidationHistory[] @relation("LiquidationHistoryDeletedBy")

  settlementsCreated Settlement[] @relation("SettlementCreatedBy")
  settlementsUpdated Settlement[] @relation("SettlementUpdatedBy")
  settlementsDeleted Settlement[] @relation("SettlementDeletedBy")

  receiptsCreated Receipt[] @relation("ReceiptCreatedBy")
  receiptsUpdated Receipt[] @relation("ReceiptUpdatedBy")
  receiptsDeleted Receipt[] @relation("ReceiptDeletedBy")

  billableExpensesCreated BillableExpense[] @relation("BillableExpenseCreatedBy")
  billableExpensesUpdated BillableExpense[] @relation("BillableExpenseUpdatedBy")
  billableExpensesDeleted BillableExpense[] @relation("BillableExpenseDeletedBy")

  companyPaidExpensesCreated CompanyPaidExpense[] @relation("CompanyPaidExpenseCreatedBy")
  companyPaidExpensesUpdated CompanyPaidExpense[] @relation("CompanyPaidExpenseUpdatedBy")
  companyPaidExpensesDeleted CompanyPaidExpense[] @relation("CompanyPaidExpenseDeletedBy")

  additionalChargesCreated AdditionalCharge[] @relation("AdditionalChargeCreatedBy")
  additionalChargesUpdated AdditionalCharge[] @relation("AdditionalChargeUpdatedBy")
  additionalChargesDeleted AdditionalCharge[] @relation("AdditionalChargeDeletedBy")

  crewDeductionsCreated CrewDeduction[] @relation("CrewDeductionCreatedBy")
  crewDeductionsUpdated CrewDeduction[] @relation("CrewDeductionUpdatedBy")
  crewDeductionsDeleted CrewDeduction[] @relation("CrewDeductionDeletedBy")

  crewDeductionRecoveriesCreated CrewDeductionRecovery[] @relation("CrewDeductionRecoveryCreatedBy")
  crewDeductionRecoveriesUpdated CrewDeductionRecovery[] @relation("CrewDeductionRecoveryUpdatedBy")
  crewDeductionRecoveriesDeleted CrewDeductionRecovery[] @relation("CrewDeductionRecoveryDeletedBy")

  adjustmentsCreated Adjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsUpdated Adjustment[] @relation("AdjustmentUpdatedBy")
  adjustmentsDeleted Adjustment[] @relation("AdjustmentDeletedBy")

  commissionsCreated Commission[] @relation("CommissionCreatedBy")
  commissionsUpdated Commission[] @relation("CommissionUpdatedBy")
  commissionsDeleted Commission[] @relation("CommissionDeletedBy")

  payoutRunsCreated PayoutRun[] @relation("PayoutRunCreatedBy")
  payoutRunsUpdated PayoutRun[] @relation("PayoutRunUpdatedBy")
  payoutRunsDeleted PayoutRun[] @relation("PayoutRunDeletedBy")

  payoutLinesCreated PayoutLine[] @relation("PayoutLineCreatedBy")
  payoutLinesUpdated PayoutLine[] @relation("PayoutLineUpdatedBy")
  payoutLinesDeleted PayoutLine[] @relation("PayoutLineDeletedBy")

  auditLogsCreated AuditLog[] @relation("AuditLogCreatedBy")
  auditLogsUpdated AuditLog[] @relation("AuditLogUpdatedBy")
  auditLogsDeleted AuditLog[] @relation("AuditLogDeletedBy")

  // --- workflow actor back-relations -------------------------------------
  auditLogsActed       AuditLog[]           @relation("AuditLogActor")
  allowancesReleased   Allowance[]          @relation("AllowanceReleasedBy")
  liquidationsApproved Liquidation[]        @relation("LiquidationApprovedBy")
  liquidationHistory   LiquidationHistory[] @relation("LiquidationHistoryActor")
  settlementsRecorded  Settlement[]         @relation("SettlementRecordedBy")
  adjustmentsApproved  Adjustment[]         @relation("AdjustmentApprovedBy")
  payoutRunsApproved   PayoutRun[]          @relation("PayoutRunApprovedBy")
  payoutRunsPaid       PayoutRun[]          @relation("PayoutRunPaidBy")
  payoutRunsVoided     PayoutRun[]          @relation("PayoutRunVoidedBy")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("user")
}

/// Presentation and contact detail for a login. Kept separate from User so the
/// security-critical columns (role, isActive, staffId) stay small.
model UserProfile {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL — at most one live profile per
  /// user, while a soft-deleted one can be replaced.
  userId String @db.Uuid
  user   User   @relation("UserProfileOwner", fields: [userId], references: [id], onDelete: Cascade)

  displayName String?
  phone       String?
  /// S3 object key for the avatar, not a URL.
  avatarKey   String?
  locale      String  @default("en-PH")
  timezone    String  @default("Asia/Manila")
  isActive    Boolean @default(true)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  /// Nullable so a self-registering user can own their first profile row.
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("UserProfileCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("UserProfileUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("UserProfileDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([deletedAt])
  @@map("user_profile")
}

// --- Better Auth infrastructure tables --------------------------------------
// Not business tables: no audit columns, no soft delete, full uniques. A
// session or verification token is genuinely transient and should be revoked
// by deletion, not retained.

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  idToken               String?
  password              String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

/// An invitation to take ownership of a provisioned login.
///
/// WHY THIS IS NOT `verification`. Better Auth's own table would hold a token
/// with an `expiresAt`, and reusing it would mean namespacing our rows by an
/// `identifier` prefix inside a table Better Auth also writes and prunes —
/// one column doing two jobs, kept apart by convention. It also models none of
/// what an administrator needs to see: who invited, whether the mail actually
/// went out, and whether the invite was revoked before it was used.
///
/// Rows are never updated in place to re-invite. Resending REVOKES the pending
/// row and inserts a new one, so the table is the history of every invite ever
/// issued rather than the current state of one.
model StaffInvitation {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  userId String @db.Uuid
  user   User   @relation("StaffInvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, hex. The plaintext exists only in the email that
  /// carried it: a database dump must not yield working invite links, and an
  /// administrator reading this table must not be able to accept on somebody
  /// else's behalf. Partial-unique WHERE "deletedAt" IS NULL.
  tokenHash String

  expiresAt  DateTime  @db.Timestamptz(6)
  /// Set once, when the invitee chooses their password. Also the moment the
  /// login becomes usable at all — `emailVerified` is written here too, since
  /// following the link is what proves they hold the mailbox.
  acceptedAt DateTime? @db.Timestamptz(6)
  /// Withdrawn by an administrator before it was used. Mutually exclusive with
  /// `acceptedAt` by CHECK — an invite cannot both be taken up and withdrawn.
  revokedAt  DateTime? @db.Timestamptz(6)

  /// When the transport accepted the message, or why it refused. Mutually
  /// exclusive by CHECK; both null means delivery has not been attempted.
  /// A failed send leaves the invitation valid — the token is already minted,
  /// so the fix is to resend, not to re-provision the account.
  sentAt        DateTime? @db.Timestamptz(6)
  deliveryError String?

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("StaffInvitationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("StaffInvitationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("StaffInvitationDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([deletedAt])
  @@map("staff_invitation")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Truck {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL.
  plateNumber String
  make        String?
  model       String?
  modelYear   Int?
  bodyType    String?
  /// Payload capacity in kilograms. NOT money — a physical quantity.
  capacityKg  Decimal? @db.Decimal(10, 2)

  registrationExpiry DateTime? @db.Timestamptz(6)
  /// Deactivated = still valid on history, not offered for new shipments
  /// (e.g. sold). Distinct from deletedAt, which removes it from use.
  isActive           Boolean   @default(true)

  shipments Shipment[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("TruckCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("TruckUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("TruckDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([deletedAt])
  @@map("truck")
}

/// Everyone who works here — drivers, helpers, and the office staff who handle
/// their money. `eligibleRoles` says what this person MAY be engaged as; the
/// role actually filled on a trip comes from the shipment slot and is recorded
/// on Commission.
///
/// It was `crew_member` until a dispatch manager needed to be the custodian of
/// a trip's cash. The alternative was a custodian column pointing at either a
/// crew member or a user — one column doing two jobs, held together by a
/// convention. Unifying the people leaves every foreign key pointing at
/// exactly one place.
model Staff {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// NOT UNIQUE, and deliberately so. `staffCode` used to carry a partial
  /// unique and was dropped; a name cannot replace it, because two people
  /// working here can genuinely be called the same thing. Forcing a
  /// discriminator into `firstName` to satisfy an index would be one column
  /// doing two jobs. Duplicates are therefore representable — tell them apart
  /// by phone, email or hire date.
  firstName String
  lastName  String
  phone     String?
  /// Contact address for the person, and where an invite would be sent if one
  /// is ever provisioned from here. Deliberately NOT unique and NOT the login:
  /// `user.email` is the credential, partial-unique and owned by Better Auth,
  /// and a staff member may have no login at all. Keeping them separate means
  /// correcting somebody's contact details cannot move an account.
  email     String?
  address   String?
  dateHired DateTime? @db.Timestamptz(6)
  /// Deactivated = still valid on history, not offered for new assignments
  /// (e.g. departed). Distinct from deletedAt.
  isActive  Boolean   @default(true)

  /// Code set: StaffRole (1 DRIVER, 2 HELPER, 3 DISPATCH_MANAGER), as a
  /// SMALLINT array. A CHECK constraint requires every element to be a valid
  /// code. A person eligible for both crew roles can drive one trip and help on
  /// another. DISPATCH_MANAGER is deliberately NOT a CrewRole: commission.role
  /// still checks IN (1, 2), so a dispatch manager cannot earn one.
  eligibleRoles Int[] @db.SmallInt

  /// Nullable: required, and validated, only when this person occupies a
  /// driver slot on a shipment.
  licenseNumber String?
  licenseExpiry DateTime? @db.Timestamptz(6)

  /// At most one live login, enforced by a partial unique index on user.
  logins User[] @relation("StaffLogin")

  drivenShipments Shipment[]      @relation("ShipmentDriver")
  helpedShipments Shipment[]      @relation("ShipmentHelper")
  commissions     Commission[]
  allowances      Allowance[]
  /// Trips whose cash this person is answerable for accounting for.
  custodyOf       Liquidation[]   @relation("LiquidationCustodian")
  deductions      CrewDeduction[]
  adjustments     Adjustment[]
  payoutLines     PayoutLine[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("StaffCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("StaffUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("StaffDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("staff")
}

model Client {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL — the name is the identity now
  /// that `code` is gone. A genuinely distinct second entity with the same
  /// registered name is named for what distinguishes it, e.g. "… (Cebu)".
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  tin         String?
  isActive    Boolean @default(true)

  shipments       Shipment[]
  commissionRules CommissionRule[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("ClientUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("ClientDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([deletedAt])
  @@map("client")
}

/// Broker or agent who brings freight and takes a cut off the gross rate.
model ThirdParty {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL — the name is the identity now
  /// that `code` is gone. A genuinely distinct second entity with the same
  /// registered name is named for what distinguishes it, e.g. "… (Cebu)".
  name        String
  contactName String?
  phone       String?
  email       String?
  isActive    Boolean @default(true)

  /// Usual cut, offered as a default when creating a shipment. The shipment's
  /// own frozen tpcAmount / appliedTpcRate are what actually govern.
  defaultCommissionRate Decimal? @db.Decimal(5, 4)

  shipments Shipment[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("ThirdPartyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("ThirdPartyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("ThirdPartyDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([deletedAt])
  @@map("third_party")
}

/// Someone OUTSIDE the company that money is disbursed TO — a fuel station, a
/// ferry operator, a vulcanizing shop.
///
/// DELIBERATELY NOT `ThirdParty`, which sits directly above it and is the merge
/// somebody will propose. A third party is a broker whose cut is netted off the
/// gross rate (`gross - tpc = net`); the company never disburses against one at
/// all, and it carries a `defaultCommissionRate` that is meaningless on a tyre
/// shop. Merging them would put a nullable rate column on rows that can never
/// use it and leave the two kinds apart by convention — the "one column, two
/// jobs" shape that has caused four defects in this schema already. They also
/// lock at different moments: a shipment's broker freezes on leaving DRAFT, a
/// liquidation line's payee freezes when that liquidation is APPROVED.
///
/// DELIBERATELY NOT `Staff` either. Cash released to a crew member is an
/// `Allowance`, whose recipient is a `Staff` foreign key, because an advance to
/// your own driver is answerable for and liquidated while a vendor payment is
/// neither. `PayeeType` has no STAFF code for the same reason.
///
/// Mirrors `Client` field-for-field apart from `payeeType`: both are external
/// organisations that appear on Philippine paperwork, so both carry an address
/// and a TIN.
model Payee {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Code set: PayeeType (1 COMPANY, 2 INDIVIDUAL). Stated, never inferred —
  /// no rule over the name tells a sole proprietor from a partnership, and the
  /// two produce different vouchers.
  payeeType Int @db.SmallInt

  name        String
  /// A company's contact person. Optional for every type: an individual payee
  /// is their own contact, and a duplicated name is one that later disagrees
  /// with itself. `expectsContactName()` decides whether the form asks.
  contactName String?
  phone       String?
  email       String?
  address     String?
  /// Philippine taxpayer identification number, as printed on a voucher.
  tin         String?
  isActive    Boolean @default(true)

  liquidationLines    LiquidationLine[]
  billableExpenses    BillableExpense[]
  companyPaidExpenses CompanyPaidExpense[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("PayeeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("PayeeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("PayeeDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([deletedAt])
  @@map("payee")
}

model Route {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL.
  name         String
  origin       String
  destination  String
  /// Kilometres. NOT money — a physical quantity.
  distanceKm   Decimal? @db.Decimal(10, 2)
  /// Indicative freight rate used to prefill a shipment. Money.
  standardRate Decimal? @db.Decimal(15, 4)

  /// What the crew are normally advanced for this run. Money.
  ///
  /// A DEFAULT, not a rule. It prefills the first allowance on a trip and is
  /// editable there, and nothing downstream reads it — the variance is measured
  /// against the allowances actually issued, never against this. A long run
  /// that hits a closed ferry costs what it costs.
  standardAllowance Decimal? @db.Decimal(15, 4)

  isActive Boolean @default(true)

  shipments       Shipment[]
  commissionRules CommissionRule[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("RouteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("RouteUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("RouteDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([deletedAt])
  @@map("route")
}

/// Categories for liquidation lines and billable expenses
/// (fuel, toll, food, parking, ferry, gate pass, miscellaneous).
model ExpenseCategory {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL.
  name String

  requiresReceipt Boolean @default(true)

  /// Whether a disbursement in this category must name who was paid.
  ///
  /// UNLIKE `requiresReceipt`, THIS ONE IS ENFORCED. A missing receipt is a
  /// judgement call the approver makes about a lost ferry ticket; a missing
  /// payee is a cost nobody can reconcile against a supplier statement, and the
  /// business asked for it to be refused rather than merely prompted.
  ///
  /// Defaults to true, which is where every category started when "paid to"
  /// was briefly mandatory everywhere. Relaxing one is therefore a deliberate
  /// act — toll booths and roadside meals are the cases that want it — rather
  /// than something a newly created category falls into by omission.
  ///
  /// The flag is COPIED onto each row it governs; see `LiquidationLine
  /// .payeeRequired` for why it is not read live.
  requiresPayee Boolean @default(true)

  /// Default for the commissionable flag when this category is used as a
  /// billable expense. The per-row flag still wins.
  defaultCommissionable Boolean @default(false)
  /// 10, not 0: the seeded categories are spaced 10 apart, so a category added
  /// without a stated order lands beside the first rather than ahead of
  /// everything — and 0 made "unspecified" indistinguishable from "first".
  sortOrder             Int     @default(10)
  isActive              Boolean @default(true)

  liquidationLines    LiquidationLine[]
  billableExpenses    BillableExpense[]
  companyPaidExpenses CompanyPaidExpense[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("ExpenseCategoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("ExpenseCategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("ExpenseCategoryDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([deletedAt])
  @@map("expense_category")
}

/// Commission rate for a role, optionally scoped to a client or route, valid
/// over a date window.
///
/// RESOLUTION (Phase 4 engine). Candidates are the active, undeleted rules
/// where the role matches, the shipment date falls in
/// [effectiveFrom, effectiveTo), and the scope matches (a null clientId or
/// routeId matches any). The winner is chosen by, in order:
///   1. specificity — client+route beats client, which beats route, which
///      beats unscoped
///   2. priority, higher first
///   3. effectiveFrom, latest first
///   4. id, purely so the result is stable
///
/// THERE IS NO FALLBACK. If nothing matches, the engine must RAISE, not
/// substitute a default. SystemSetting once carried driver/helper rates for
/// exactly that purpose and they were deliberately removed: a silent default
/// turns an expired or mis-scoped rule into a plausible wrong number that then
/// freezes onto the commission, and nobody finds out until a payout is
/// questioned. The unscoped, open-ended, priority-0 rules created by the seed
/// are the company-wide baseline, and they are ordinary rules like any other.
///
/// Whichever rule wins, its rate is copied onto Commission.appliedRate and
/// frozen there, so editing or deleting this row later cannot move a
/// commission that has already been computed.
model CommissionRule {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name String

  /// Code set: CrewRole (1 DRIVER, 2 HELPER).
  role Int @db.SmallInt

  /// Code set: CommissionMethod (1 PERCENT_OF_BASE, 2 FIXED_PER_TRIP,
  /// 3 FIXED_PER_ROUTE, 4 PERCENT_OF_NET_RATE, 5 FORMULA). The CHECK guards
  /// the code set, not the feature set; refusing a method whose strategy does
  /// not exist yet stays the service layer's job.
  method Int @default(1) @db.SmallInt

  /// Used by the rate-based methods (PERCENT_OF_BASE, PERCENT_OF_NET_RATE).
  rate        Decimal? @db.Decimal(5, 4)
  /// Used by the fixed methods (FIXED_PER_TRIP, FIXED_PER_ROUTE). Money.
  fixedAmount Decimal? @db.Decimal(15, 4)

  /// Structured configuration for methods whose definition does not fit in a
  /// single column. Today that is FORMULA alone, which stores
  /// `{ "expression": "commissionable_base * 0.15" }`.
  ///
  /// The expression is PARSED AND VALIDATED BEFORE THIS ROW IS WRITTEN, against
  /// the fixed field catalog in @eztruckr/types. A rule that failed validation
  /// is never persisted, so the engine never has to evaluate an expression it
  /// has not already proved well-formed. It is never passed to eval, Function
  /// or vm — see the parser docblock; this column holds data, not code.
  params Json?

  /// Narrower scope wins; ties break on priority (higher first).
  clientId String? @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  routeId  String? @db.Uuid
  route    Route?  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  priority Int     @default(0)

  effectiveFrom DateTime  @db.Timestamptz(6)
  /// Null means open-ended.
  effectiveTo   DateTime? @db.Timestamptz(6)
  isActive      Boolean   @default(true)

  /// The commissions this rule produced. Editing or deleting the rule cannot
  /// move any of them — each froze the rate, method and name it used — but the
  /// link makes "which rule paid this?" answerable without inference.
  commissions Commission[] @relation("CommissionAppliedRule")

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("CommissionRuleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("CommissionRuleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("CommissionRuleDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([role, isActive, effectiveFrom])
  @@index([clientId])
  @@index([routeId])
  @@index([deletedAt])
  @@map("commission_rule")
}

/// Single mutable row of system-wide defaults.
///
/// Changing a rate here must NEVER alter an already-computed commission: every
/// shipment and commission freezes the values it actually used.
///
/// COMMISSION RATES DO NOT LIVE HERE. `CommissionRule` is the only source of
/// truth for what a driver or helper is paid. This table once carried
/// `driverCommissionRate` / `helperCommissionRate` as a fallback for when no
/// rule matched. That was two places to look for one number, and the weaker of
/// the two: a fallback rate has no effective window, no scope and no priority,
/// so it could not answer "what was the helper rate in March?" — the very
/// question `CommissionRule.effectiveFrom` exists for. Worse, it failed
/// silently: a deactivated, expired or mis-scoped rule would quietly pay the
/// default instead of raising, and nobody would find out until someone
/// questioned a payout. The columns were dropped; a shipment matching no rule
/// is now an error the engine raises, not a number it invents.
model SystemSetting {
  id String @id @default("singleton")

  /// When the first administrator was created, through `POST /system/initialize`.
  ///
  /// STORED, not derived from "does an administrator exist", and the difference
  /// is the security property. `/system/initialize` is public — it has to be,
  /// since nobody can sign in before it runs — and what closes it is this
  /// column being set. Deriving it from a user count would reopen a public
  /// administrator-creation endpoint the moment the last admin was removed or
  /// deactivated, which is a privilege escalation with a very short recipe.
  ///
  /// Once set, never cleared. Its being on the singleton row is also what makes
  /// initialising atomic: two concurrent requests both try to move it from
  /// null, and the `WHERE "initializedAt" IS NULL` on the update means exactly
  /// one of them affects a row.
  initializedAt DateTime? @db.Timestamptz(6)

  /// Share of fuel spend deducted before commission is computed. Genuinely
  /// system-wide: not a per-role rate, so it has no CommissionRule equivalent
  /// and no ambiguity about which role's value governs a shared base.
  gasExpenseDeductionRate Decimal @default(0.25) @db.Decimal(5, 4)

  currencyCode String @default("PHP")
  timezone     String @default("Asia/Manila")

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("SystemSettingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("SystemSettingDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@map("system_setting")
}

// ---------------------------------------------------------------------------
// Shipment and the rate chain
// ---------------------------------------------------------------------------

model Shipment {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL.
  shipmentNumber String

  /// Code set: ShipmentStatus (1 DRAFT, 2 DISPATCHED, 3 IN_TRANSIT,
  /// 4 DELIVERED, 5 PENDING_LIQUIDATION, 6 LIQUIDATED, 7 CLOSED). Order comes
  /// from the declared sequence in @eztruckr/types, never from the numeric
  /// value.
  ///
  /// DELIVERED is a transition, not a resting place: recording delivery writes
  /// PENDING_LIQUIDATION in the same statement, so "awaiting liquidation" is a
  /// state you can filter on rather than one inferred from a missing row.
  status Int @default(1) @db.SmallInt

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// Null for direct clients — there is no broker cut.
  thirdPartyId String?     @db.Uuid
  thirdParty   ThirdParty? @relation(fields: [thirdPartyId], references: [id], onDelete: Restrict)

  routeId String? @db.Uuid
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  truckId String? @db.Uuid
  truck   Truck?  @relation(fields: [truckId], references: [id], onDelete: Restrict)

  /// The date the trip ran, as it appears on the paperwork.
  ///
  /// DELIBERATELY NOT `dispatchedAt`. That one is an event the system stamps
  /// when somebody presses dispatch, so it can only ever say when the row was
  /// touched; this is a fact about the trip, which a booking typed up a week
  /// late still has to be able to state correctly. Defaults to now, so the
  /// common case — booked the day it runs — needs nobody to fill it in.
  shipmentDate DateTime @default(now()) @db.Timestamptz(6)

  /// Snapshotted from the route at dispatch so later edits to the route do not
  /// rewrite history.
  origin           String
  destination      String
  cargoDescription String?

  /// The container or van number on the trailer, for containerised freight.
  ///
  /// Nullable, because plenty of freight is not in a box — and a required
  /// field is answered with "N/A", which looks like a container number and is
  /// not. Matched by the shipment search alongside the number and the lane,
  /// because it is what a client phones up quoting.
  containerNumber String?

  driverId String? @db.Uuid
  driver   Staff?  @relation("ShipmentDriver", fields: [driverId], references: [id], onDelete: Restrict)
  helperId String? @db.Uuid
  helper   Staff?  @relation("ShipmentHelper", fields: [helperId], references: [id], onDelete: Restrict)

  dispatchedAt DateTime? @db.Timestamptz(6)
  deliveredAt  DateTime? @db.Timestamptz(6)
  closedAt     DateTime? @db.Timestamptz(6)

  // --- rate chain: gross - tpc = net ------------------------------------
  grossRate      Decimal  @db.Decimal(15, 4)
  /// Resolved broker cut in pesos. Zero for direct clients.
  tpcAmount      Decimal  @default(0) @db.Decimal(15, 4)
  netRate        Decimal  @default(0) @db.Decimal(15, 4)
  /// Set when the TPC was derived as a percentage of gross; null when it was
  /// agreed as a flat amount. Frozen at computation.
  appliedTpcRate Decimal? @db.Decimal(5, 4)

  // --- the gas deduction rate: one input, one output --------------------
  //
  // These are deliberately separate columns, and the separation is the point.
  // They were briefly one: `appliedGasDeductionRate` served as both the rate a
  // person had asked for and the rate the engine froze, with
  // `gasRateOverrideReason` left to disambiguate the two. That encoding worked
  // but was a convention rather than a constraint — no CHECK could enforce it,
  // because the database had the same missing information — and it made
  // recomputation depend on whether a reason string happened to be present.
  // Money behaviour should not rest on that.

  /// INPUT. What somebody deliberately asked this shipment to use, instead of
  /// the system-wide default. Null means "use the default".
  ///
  /// A reason is mandatory alongside it and a CHECK requires the two to travel
  /// together: an unexplained override is indistinguishable from a typo when
  /// somebody reviews the payout months later, and this rate moves the
  /// commission base for every crew member on the trip.
  gasRateOverride       Decimal? @db.Decimal(5, 4)
  gasRateOverrideReason String?

  // --- commission inputs, frozen at computation time --------------------
  /// OUTPUT. The rate the last computation actually used — the override above
  /// if there was one, otherwise the system default as it stood at that
  /// moment. Null until commissions are computed.
  ///
  /// Like every other applied* column, this is written only by the engine and
  /// never by a request.
  appliedGasDeductionRate Decimal? @db.Decimal(5, 4)

  // --- commission chain; every step stored, each rounded to 2dp ----------
  /// Sum of billable expenses and additional charges flagged commissionable.
  commissionableCharges Decimal?  @db.Decimal(15, 4)
  /// netRate + commissionableCharges.
  grossForCommission    Decimal?  @db.Decimal(15, 4)
  /// grossForCommission x appliedGasDeductionRate. Reduces the commission base
  /// ONLY — never a P&L cost line, since actual fuel is recognised through the
  /// liquidation.
  gasDeductionAmount    Decimal?  @db.Decimal(15, 4)
  /// grossForCommission - gasDeductionAmount. Multiplying this stored value by
  /// a stored crew rate must reproduce the stored commission exactly.
  commissionableBase    Decimal?  @db.Decimal(15, 4)
  commissionsComputedAt DateTime? @db.Timestamptz(6)

  /// When the gross rate or the broker cut was last corrected AFTER booking.
  /// Null while they still stand as they were booked.
  ///
  /// Exists only so `isComputationStale` has something to compare against. The
  /// rate chain was frozen at dispatch when commissions were first built, so a
  /// stored commission could not fall behind it; it is correctable now, and
  /// `updatedAt` cannot stand in — it moves when the truck is swapped, which
  /// says nothing about the base.
  rateChainUpdatedAt DateTime? @db.Timestamptz(6)

  allowances          Allowance[]
  liquidations        Liquidation[]
  settlements         Settlement[]
  billableExpenses    BillableExpense[]
  companyPaidExpenses CompanyPaidExpense[]
  additionalCharges   AdditionalCharge[]
  commissions         Commission[]
  adjustments         Adjustment[]
  crewDeductions      CrewDeduction[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("ShipmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("ShipmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("ShipmentDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([clientId])
  @@index([driverId])
  @@index([helperId])
  @@index([truckId])
  @@index([dispatchedAt])
  @@index([deletedAt])
  @@map("shipment")
}

/// ONE RELEASE of cash to the crew. Many rows per shipment, never one.
///
/// A trip carries an initial advance and, often, top-ups called in from the
/// road — a ferry queue, a re-weighing fee, a breakdown. Each release is its
/// own row with its own date, mode and paper trail, because each one is a
/// separate movement of cash that somebody has to be able to point at. The
/// shipment's total advanced is the SUM of these; there is deliberately no
/// editable "allowance amount" on the shipment for a second release to
/// overwrite, which would leave the first one with no record it ever happened.
///
/// NOT a P&L cost: an allowance is a receivable from the crew, cleared by the
/// liquidation. Only liquidated actual expenses are recognised as cost.
model Allowance {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  /// WHICH ACCOUNT this release is booked against — whose variance it moves.
  ///
  /// The pair (liquidationId, shipmentId) is a single composite foreign key to
  /// `liquidation (id, shipmentId)`, so a release can never be booked against
  /// an account on a DIFFERENT trip. `shipmentId` is kept rather than reached
  /// through the liquidation precisely so that key can exist: the redundancy is
  /// what the database checks, not something it has to be trusted about.
  liquidationId String      @db.Uuid
  liquidation   Liquidation @relation(fields: [liquidationId, shipmentId], references: [id, shipmentId], onDelete: Restrict)

  /// Crew member who physically RECEIVED the cash. Deliberately independent of
  /// the liquidation's custodian: a helper can be handed ferry money that the
  /// driver remains answerable for, and both facts are worth keeping.
  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  amount   Decimal  @db.Decimal(15, 4)
  issuedAt DateTime @default(now()) @db.Timestamptz(6)
  remarks  String?

  /// The user who released the cash. Distinct from `createdBy`, which is
  /// whoever typed the row in: a supervisor hands over cash in the yard and a
  /// clerk records it that afternoon, and a voucher has to name the first.
  releasedBy     String @db.Uuid
  releasedByUser User   @relation("AllowanceReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)

  /// Code set: DisbursementMode (1 CASH, 2 BANK_TRANSFER, 3 EWALLET).
  disbursementMode Int @db.SmallInt

  /// Bank or wallet reference. OPTIONAL FOR EVERY MODE, including transfers:
  /// the alternative is a required field somebody fills with "N/A", which looks
  /// like evidence and is not. `expectsReferenceNumber()` decides whether the
  /// form asks; nothing requires it.
  referenceNumber String?

  /// Proof of release — a deposit slip, a wallet screenshot. Same table and the
  /// same S3 pipeline as a liquidation receipt, because it is the same kind of
  /// object and splitting it would mean two upload paths to keep in step.
  receiptId String?  @db.Uuid
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("AllowanceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("AllowanceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("AllowanceDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([liquidationId])
  @@index([staffId])
  @@index([releasedBy])
  @@index([deletedAt])
  @@map("allowance")
}

/// The crew accounting for what they spent the trip's cash on.
///
/// LIFECYCLE: PENDING -> SUBMITTED -> APPROVED, and nothing else. The row is
/// created at PENDING the moment the shipment is marked delivered, so a trip
/// awaiting paperwork is a state you can query rather than a missing row.
/// Costs post to the P&L on APPROVED — derived from this status, never posted
/// into a ledger — and the liquidation locks there.
///
/// RETURNING IS NOT A STATUS. Accounting returns work with a required reason
/// and it goes back to PENDING, which already means "with the crew, awaiting
/// their action". What a `RETURNED` state would have recorded is recorded
/// better by `LiquidationHistory`, which also says when, by whom and why. See
/// the code set for the full argument.
/// ONE CUSTODIAN'S ACCOUNT of one trip's cash. Many per shipment.
///
/// It was one per shipment until the custodian existed, and that single row
/// was quietly blending two people's money: with a driver holding ₱10,000 and
/// a helper holding ₱3,000, one `variance` could only ever say what the TRIP
/// was short by, never which of them owed it. The settlement built on top
/// inherited the same blindness, and a crew member could be chased for change
/// their colleague was holding.
///
/// A custodian is the person accountable for accounting — not necessarily the
/// person who received every peso. An allowance names its own recipient, so a
/// helper can be handed ferry money that the driver is still answerable for.
model Liquidation {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  /// The staff member answerable for this cash. Not necessarily on the truck:
  /// a dispatch manager holds a trip's float without driving or helping.
  ///
  /// Nullable, because a trip's first liquidation is created at BOOKING, before
  /// anybody has been assigned to drive it. Partial-unique on
  /// (shipmentId, custodianId) WHERE "deletedAt" IS NULL and NULLS NOT
  /// DISTINCT — one open account per person per trip, and only one that has
  /// nobody's name on it yet, because two unnamed accounts are indistinguishable.
  custodianId String? @db.Uuid
  custodian   Staff?  @relation("LiquidationCustodian", fields: [custodianId], references: [id], onDelete: Restrict)

  /// Code set: LiquidationStatus (1 PENDING, 2 SUBMITTED, 3 APPROVED). Order
  /// comes from the declared sequence in @eztruckr/types, never from the
  /// number — it matches today and will not once a status is appended.
  status Int @default(1) @db.SmallInt

  /// Sum of THIS liquidation's allowances — the releases booked against this
  /// custodian, not every release on the trip. Recomputed while the liquidation
  /// is open and frozen on approval.
  totalAllowance  Decimal @default(0) @db.Decimal(15, 4)
  /// Sum of the liquidation lines — this is the figure recognised as P&L cost.
  totalLiquidated Decimal @default(0) @db.Decimal(15, 4)
  /// totalAllowance - totalLiquidated. Positive = crew returns cash, negative =
  /// company reimburses crew. Settled separately; never a P&L line.
  variance        Decimal @default(0) @db.Decimal(15, 4)

  /// Null until the crew first submit. NOT a creation timestamp — a liquidation
  /// exists from the moment of delivery, and `createdAt` records that. A
  /// resubmission after a return moves this forward; every submission is kept
  /// in `history` regardless.
  submittedAt DateTime? @db.Timestamptz(6)

  approvedAt     DateTime? @db.Timestamptz(6)
  approvedBy     String?   @db.Uuid
  approvedByUser User?     @relation("LiquidationApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  remarks        String?

  /// The voucher or document number this account was settled under.
  ///
  /// Optional, and never unique. A reference is what somebody wrote on a piece
  /// of paper; this system issues no such number and cannot vouch for one, so
  /// enforcing uniqueness on it would only refuse the truth when two documents
  /// genuinely carry the same reference.
  referenceNumber String?

  lines       LiquidationLine[]
  history     LiquidationHistory[]
  allowances  Allowance[]
  settlements Settlement[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("LiquidationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("LiquidationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("LiquidationDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  /// Lets a child row reference (liquidationId, shipmentId) as one foreign key,
  /// which is what makes "an allowance's liquidation is on its own shipment"
  /// a structural fact rather than something a service remembers to check.
  /// `map:`, not `name:` — the first sets the constraint name in Postgres, the
  /// second only renames the compound key in the generated client.
  @@unique([id, shipmentId], map: "liquidation_id_shipment_key")
  @@index([shipmentId])
  @@index([custodianId])
  @@index([status])
  @@index([deletedAt])
  @@map("liquidation")
}

/// Append-only record of every submission and every return.
///
/// WHY THIS EXISTS: both events leave the liquidation at a status it has held
/// before. Without these rows, a liquidation returned twice and resubmitted
/// looks exactly like one submitted for the first time, and the crew are told
/// to correct something with no record of what. Nothing here is ever updated or
/// deleted — a corrected reason is a new row, not an edit to the old one.
///
/// WHAT READS IT: the crew portal shows the latest RETURNED row's reason, and
/// the dashboard's "returned for correction" filter is PENDING with any history
/// at all. Both of those are the questions a `RETURNED` status would have
/// answered worse.
model LiquidationHistory {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  liquidationId String      @db.Uuid
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Restrict)

  /// Code set: LiquidationHistoryAction (1 SUBMITTED, 2 RETURNED).
  action Int @db.SmallInt

  /// Who did it. Separate from `createdBy` for the same reason as an
  /// allowance's `releasedBy`: the actor is the point of the row, not an audit
  /// footnote, and it is what the portal renders.
  actorId String @db.Uuid
  actor   User   @relation("LiquidationHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  /// Required on a RETURNED row, forbidden on a SUBMITTED one, enforced by
  /// `liquidation_history_reason_matches_action`. A return with no reason is
  /// the crew being told to try again with no idea what was wrong; a blank
  /// reason box on every submission would only dilute the ones that matter.
  reason String?

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("LiquidationHistoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("LiquidationHistoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("LiquidationHistoryDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([liquidationId, occurredAt])
  @@index([actorId])
  @@index([deletedAt])
  @@map("liquidation_history")
}

model LiquidationLine {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  liquidationId String      @db.Uuid
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Restrict)

  expenseCategoryId String          @db.Uuid
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  description String?
  amount      Decimal  @db.Decimal(15, 4)
  spentAt     DateTime @db.Timestamptz(6)

  /// Who the crew paid. Required only when `payeeRequired` says so.
  payeeId String? @db.Uuid
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  /// Whether THIS line had to name a payee, copied from its expense category
  /// when the line was written.
  ///
  /// FROZEN, NOT READ LIVE, and that is the whole point of the column. The rule
  /// lives on `ExpenseCategory.requiresPayee`, but a CHECK cannot reach across
  /// tables — and enforcing against the category's CURRENT value would mean
  /// that flipping "Tolls" to required retroactively invalidates every toll
  /// line ever written, so correcting one of them would fail on a rule that did
  /// not exist when it was recorded. Freezing the rule onto the row it governed
  /// is the same move `appliedTpcRate` and `appliedMethod` make, for the same
  /// reason: a row must stay re-derivable a year later.
  ///
  /// Paired with `payeeId` by `liquidation_line_payee_required` so the database
  /// enforces it rather than the service being trusted to.
  payeeRequired Boolean @default(true)

  /// Partial-unique WHERE "deletedAt" IS NULL — a receipt backs at most one
  /// live line.
  receiptId String?  @db.Uuid
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("LiquidationLineCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("LiquidationLineUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("LiquidationLineDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([liquidationId])
  @@index([expenseCategoryId])
  @@index([payeeId])
  @@index([deletedAt])
  @@map("liquidation_line")
}

/// A file in S3-compatible object storage. Holds the object key, never a URL.
///
/// One table for every attachment in the system — liquidation receipts, proof
/// of an allowance release, proof of a settlement — because they are the same
/// kind of object and a second upload path would be a second thing to keep in
/// step with bucket configuration, size limits and MIME checks.
///
/// The bytes are served back through the API rather than by a presigned link.
/// A presigned URL is a bearer token for the object that outlives the request
/// and travels outside the role guard, which is the wrong shape for a receipt a
/// crew member may see and a colleague may not.
model Receipt {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL.
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String?

  uploadedAt DateTime @default(now()) @db.Timestamptz(6)

  liquidationLines    LiquidationLine[]
  billableExpenses    BillableExpense[]
  companyPaidExpenses CompanyPaidExpense[]
  allowances          Allowance[]
  settlements         Settlement[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("ReceiptCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("ReceiptUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("ReceiptDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@map("receipt")
}

/// What happened to the cash left over after a trip was liquidated.
///
/// ONE RECORD PER SHIPMENT, not per allowance, and that is a modelling decision
/// rather than a convenience. With an initial advance and two top-ups there is
/// no meaningful way to say which release a returned ₱800 came from — the crew
/// spent from one pocket. Attaching settlement to individual allowances would
/// force an arbitrary allocation and then report it as fact.
///
/// The amount is the variance: positive means the crew hold cash that has to
/// come back, negative means the company owes them. Both directions are
/// documented the same way as the release was — mode, optional reference,
/// optional attachment — so a trip's cash trail reads identically in both
/// directions.
///
/// THIS IS WHAT THE "ALLOWANCES OUTSTANDING" ALERT READS. Never the
/// liquidation: an approved liquidation says the spending was accounted for and
/// says nothing at all about whether the leftover cash came back.
model Settlement {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  /// WHOSE leftover cash this is — partial-unique WHERE "deletedAt" IS NULL, so
  /// at most one live settlement per LIQUIDATION rather than per shipment. A
  /// reversed approval soft-deletes it, and re-approval writes a fresh one
  /// against the recomputed variance.
  ///
  /// It moved off the shipment when a trip gained more than one custodian: two
  /// people each holding change cannot share one settlement row, and the
  /// blended figure the old shape produced would chase one of them for the
  /// other's money. Composite FK on (liquidationId, shipmentId), same as an
  /// allowance and for the same reason.
  liquidationId String      @db.Uuid
  liquidation   Liquidation @relation(fields: [liquidationId, shipmentId], references: [id, shipmentId], onDelete: Restrict)

  /// Code set: SettlementStatus (1 OUTSTANDING, 2 SETTLED, 3 CARRIED_TO_PAYOUT).
  status Int @default(1) @db.SmallInt

  /// The variance being settled, frozen from the liquidation at approval.
  /// Signed: positive = crew returns cash, negative = company reimburses crew.
  amount Decimal @db.Decimal(15, 4)

  // --- the movement, mirroring how the allowance was released ---------------

  /// Code set: DisbursementMode. Null until the money actually moves, and null
  /// forever on a zero variance, where there is nothing to move. A CHECK ties
  /// it to the status rather than leaving it to convention.
  disbursementMode Int?    @db.SmallInt
  referenceNumber  String?

  receiptId String?  @db.Uuid
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  settledAt     DateTime? @db.Timestamptz(6)
  settledBy     String?   @db.Uuid
  settledByUser User?     @relation("SettlementRecordedBy", fields: [settledBy], references: [id], onDelete: Restrict)
  remarks       String?

  /// Set only when the balance is being recovered from the crew's pay instead
  /// of in cash. The debt itself is an ordinary `CrewDeduction`, recovered in
  /// slices by payout runs like any other, so this status needs no parallel
  /// recovery machinery — it clears when that deduction is fully recovered by
  /// runs that have been marked Paid.
  ///
  /// Only a positive variance can be carried: recovering money the crew owe is
  /// a deduction, while money the COMPANY owes is not something a payout run
  /// recovers, and inventing an adjustment for it here would be guessing at
  /// what should be handed over in cash.
  crewDeductionId String?        @db.Uuid
  crewDeduction   CrewDeduction? @relation(fields: [crewDeductionId], references: [id], onDelete: Restrict)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("SettlementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("SettlementUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("SettlementDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([liquidationId])
  @@index([status])
  @@index([crewDeductionId])
  @@index([deletedAt])
  @@map("settlement")
}

// ---------------------------------------------------------------------------
// Client charges
// ---------------------------------------------------------------------------

/// A cost the company fronted and recovers from the client (permit, crane,
/// port charges). Adds to revenue and is also a real cost.
///
/// CARRIES THE SAME FIELDS AS `CompanyPaidExpense`, and the one difference is
/// the point of both tables: this one is rebilled to the client and can feed
/// the crew's commission base, that one is simply a cost. Everything else —
/// what it was for, when the money left, who was paid, the paper behind it —
/// is the same question asked of the same act of spending, and the two forms
/// disagreeing about which of those to ask was an accident of which was
/// written first.
model BillableExpense {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  expenseCategoryId String?          @db.Uuid
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  /// Optional, unlike the amount: a category and a payee say more than a
  /// description box repeating the category's own name. Rows written before
  /// there was a category to pick still carry theirs.
  description      String?
  amount           Decimal  @db.Decimal(15, 4)
  /// When the money left, which is not when the row was typed.
  spentAt          DateTime @db.Timestamptz(6)
  /// Whether this amount feeds the commission base. The one field with no
  /// counterpart on a company-paid expense, because only this side can.
  isCommissionable Boolean  @default(false)

  /// Who was paid. Required only when `payeeRequired` says so.
  payeeId String? @db.Uuid
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  /// Copied from the expense category when the row was written. Frozen for the
  /// same reason as `LiquidationLine.payeeRequired` — see the note there. Every
  /// row predating the column reads false, because no payee could have been
  /// named then and a frozen rule must state what actually applied.
  payeeRequired Boolean @default(true)

  /// Invoice, official receipt or transaction reference. Optional and never
  /// unique, the same rule as `Allowance.referenceNumber`.
  referenceNumber String?

  /// Partial-unique WHERE "deletedAt" IS NULL.
  receiptId String?  @db.Uuid
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("BillableExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("BillableExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("BillableExpenseDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([expenseCategoryId])
  @@index([payeeId])
  @@index([deletedAt])
  @@map("billable_expense")
}

/// A trip cost the COMPANY paid directly, so it never passed through the crew's
/// cash and is never liquidated.
///
/// The gap this fills: a fleet-card fuel purchase, an office-paid toll account,
/// a repair invoiced to the company. Real costs of the trip that nobody on it
/// can account for, because none of them ever held the money. Before this
/// table they had two possible homes and both lied — a LiquidationLine would
/// put a variance on a crew who were never advanced it, and a BillableExpense
/// would invent revenue from a client who is not being charged.
///
/// RECOGNISED WHEN RECORDED. There is no status column, because there is no
/// lifecycle to wait for: the money left the company before anybody typed the
/// row. Contrast LiquidationLine, whose cost is recognised only on approval
/// because until then it is the crew's claim about cash they were given.
///
/// Editable until the trip is CLOSED — deliberately NOT locked on `paid`, the
/// way charges are. A charge feeds the commission base and a paid commission
/// names a figure it must keep reconciling; this feeds no commission at all, so
/// the only thing that should stop the record being corrected is the trip being
/// closed for good.
model CompanyPaidExpense {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  /// Required, unlike a billable expense's: this row exists to be a cost in the
  /// P&L, and an uncategorised cost is one nobody can report on.
  expenseCategoryId String          @db.Uuid
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  description String?
  amount      Decimal  @db.Decimal(15, 4)
  /// When the money left, which is not when the row was typed.
  spentAt     DateTime @db.Timestamptz(6)

  /// Who the company paid. Required only when `payeeRequired` says so.
  payeeId String? @db.Uuid
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  /// Copied from the expense category when the row was written. Frozen for the
  /// same reason as `LiquidationLine.payeeRequired` — see the note there.
  payeeRequired Boolean @default(true)

  /// Invoice, official receipt or transaction reference. Optional and never
  /// unique, the same rule as `Allowance.referenceNumber`.
  referenceNumber String?

  /// Partial-unique WHERE "deletedAt" IS NULL — a receipt backs at most one
  /// live row, the same rule as every other attachment in the system.
  receiptId String?  @db.Uuid
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("CompanyPaidExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("CompanyPaidExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("CompanyPaidExpenseDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([expenseCategoryId])
  @@index([payeeId])
  @@index([deletedAt])
  @@map("company_paid_expense")
}

/// A fee or surcharge with no underlying cost (extra drop, detention, fuel
/// surcharge). Pure revenue.
model AdditionalCharge {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  description      String
  amount           Decimal @db.Decimal(15, 4)
  isCommissionable Boolean @default(false)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("AdditionalChargeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("AdditionalChargeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("AdditionalChargeDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([deletedAt])
  @@map("additional_charge")
}

// ---------------------------------------------------------------------------
// Crew ledger
// ---------------------------------------------------------------------------

/// A charge against a staff member (cash shortage, damage, violation).
/// Recovered at payout. Never a client charge.
///
/// A DEDUCTION IS DIVISIBLE, WHICH IS WHY IT LOOKS DIFFERENT FROM A COMMISSION.
/// A commission is paid whole or not at all, so `Commission.payoutLineId` is a
/// single link. A ₱9,000 damage claim against a crew member earning ₱1,800 a
/// fortnight cannot be taken in one go — it comes back a slice at a time, over
/// several runs. This model therefore has no payout link of its own: the
/// recoveries are rows in `CrewDeductionRecovery`, one per run that took a
/// slice.
///
/// It previously carried a single `payoutLineId` plus a `recovered` running
/// total, which was two incompatible designs at once. The link was repointed
/// on every run, so all but the last recovery vanished and an earlier payout
/// voucher could no longer be itemised; and the running total was a mutable
/// number with no record of what made it up.
model CrewDeduction {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  /// Optional link to the trip the deduction arose from.
  shipmentId String?   @db.Uuid
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  reason     String
  amount     Decimal  @db.Decimal(15, 4)
  incurredAt DateTime @default(now()) @db.Timestamptz(6)

  /// Every slice clawed back, one row per payout line that took one.
  ///
  /// HOW MUCH IS OUTSTANDING IS DERIVED FROM THESE, never stored. A cached
  /// `recovered` column lived here and was dropped: it is the same mistake as
  /// the commission-rate fallback, two places holding one number where the
  /// weaker one wins silently when they disagree. The sum of live recoveries
  /// is the only answer, and `crew_deduction_recovery_not_over_recovered`
  /// stops it exceeding the debt.
  ///
  /// SETTLEMENT IS DERIVED TOO — a debt is settled when the recoveries reach
  /// its amount — and there is no `isSettled` column, deliberately.
  ///
  /// DEBTS ARE NEVER WRITTEN OFF. Confirmed by the business: a crew debt is
  /// either recovered in full or carried indefinitely, so there is no state
  /// where a deduction is closed while still partly unrecovered. Do not add
  /// an `isSettled` flag or a write-off amount to express one. If that ever
  /// changes, a write-off is its own record with a reason and an approver
  /// (like `Adjustment`), not a boolean that can disagree with the sum
  /// underneath it.
  recoveries CrewDeductionRecovery[]

  /// Set when this debt is a trip's unreturned allowance carried to payout.
  /// At most one, by partial unique on settlement."shipmentId".
  settlements Settlement[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("CrewDeductionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("CrewDeductionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("CrewDeductionDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@index([deletedAt])
  @@map("crew_deduction")
}

/// One slice of a crew deduction, recovered by one payout line.
///
/// This is the money movement itself, so it is a record rather than a pointer:
/// it says which debt, which run, and how much — which is exactly what an
/// itemised voucher needs, and exactly what a repointed foreign key destroyed.
///
/// IDEMPOTENCY, mirroring the commission guarantees. Once the run is PAID the
/// row is frozen: triggers refuse to change its amount or its links, to delete
/// it, and to soft-delete it. Without that, re-running recovery would take the
/// same slice twice and short-change the crew member — the mirror image of the
/// double-payment the commission triggers exist to prevent, and previously
/// unguarded on this side of the ledger entirely.
///
/// Partial-unique on (crewDeductionId, payoutLineId) WHERE "deletedAt" IS NULL,
/// so one line cannot take two slices of one debt.
model CrewDeductionRecovery {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  crewDeductionId String        @db.Uuid
  crewDeduction   CrewDeduction @relation(fields: [crewDeductionId], references: [id], onDelete: Restrict)

  payoutLineId String     @db.Uuid
  payoutLine   PayoutLine @relation(fields: [payoutLineId], references: [id], onDelete: Restrict)

  /// Money. Must be positive: a negative recovery would be a repayment TO the
  /// crew member, which is an adjustment, not a recovery.
  amount Decimal @db.Decimal(15, 4)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("CrewDeductionRecoveryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("CrewDeductionRecoveryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("CrewDeductionRecoveryDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([crewDeductionId])
  @@index([payoutLineId])
  @@index([deletedAt])
  @@map("crew_deduction_recovery")
}

/// Manual increase or decrease applied to a crew member at payout. Reason and
/// approver are both required.
/// A manual increase or decrease to what a crew member is paid.
///
/// NOT AN EDIT TO A COMMISSION, and it must never become one. A `Commission`
/// row is self-verifying — base x rate = amount from values on the row alone —
/// so writing an adjustment into `amount` would break the one property that
/// makes a payout defensible months later. It is a sibling row, and the two are
/// added together only when something asks what a person is actually owed.
///
/// SCOPED BY `shipmentId`, NOT BY COMMISSION ID, and that is load-bearing rather
/// than a preference. Recomputing a shipment SOFT-DELETES its commissions and
/// creates new ones, so a link to a commission row would dangle every time a
/// late charge was recorded — the adjustment would silently detach from the pay
/// it was adjusting. A trip and a crew member both survive recomputation, so
/// the adjustment stays attached to what it was actually about.
///
/// A NULL `shipmentId` is a standing adjustment against the person rather than
/// a trip: a uniform deduction, a month-end bonus. Both kinds land on a payout
/// line the same way, which is why they are one table.
model Adjustment {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  /// The trip this adjusts pay for, or null for a standing adjustment against
  /// the crew member. See the model docblock for why this is not a commission
  /// id.
  shipmentId String?   @db.Uuid
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  /// Code set: AdjustmentDirection (1 INCREASE, 2 DECREASE). The DIRECTION
  /// carries the sign; `amount` is always a positive magnitude, so a decrease
  /// cannot be recorded twice over as a negative increase.
  direction Int     @db.SmallInt
  amount    Decimal @db.Decimal(15, 4)
  /// Required, and required to be non-blank by CHECK. An unexplained change to
  /// somebody's pay is indistinguishable from an error when they query it.
  reason    String

  approvedBy     String   @db.Uuid
  approvedByUser User     @relation("AdjustmentApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  approvedAt     DateTime @default(now()) @db.Timestamptz(6)

  /// Set when a payout run picks this up. THE LOCK: an adjustment that has been
  /// paid can no longer be edited or removed, for the same reason a paid
  /// commission cannot — the voucher behind it has to keep reconciling.
  payoutLineId String?     @db.Uuid
  payoutLine   PayoutLine? @relation(fields: [payoutLineId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("AdjustmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("AdjustmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("AdjustmentDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([staffId])
  @@index([shipmentId])
  @@index([payoutLineId])
  @@index([deletedAt])
  @@map("adjustment")
}

// ---------------------------------------------------------------------------
// Commissions and payout
// ---------------------------------------------------------------------------

/// One computed commission for one crew member on one shipment.
///
/// Self-verifying by design: for the default model (PERCENT_OF_BASE),
/// commissionableBase x appliedRate = amount using only values stored on this
/// row. The other methods do not derive their amount that way, so their
/// appliedRate is a REPORTED rate rather than an operand — see the column.
/// Whichever method ran, the row states the figure and the inputs it came
/// from, so a reviewer never has to consult the rule that produced it.
model Commission {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  /// Code set: CrewRole (1 DRIVER, 2 HELPER) — the role actually filled on
  /// this trip. Partial-unique on (shipmentId, role) WHERE "deletedAt" IS NULL.
  role Int @db.SmallInt

  /// Code set: CommissionMethod — how this amount was derived, frozen so the
  /// row stays interpretable if the rule changes method later.
  appliedMethod Int @default(1) @db.SmallInt

  /// WHICH RULE PAID THIS — the id for tracing, the name as it read at the
  /// time for reading.
  ///
  /// The pair is deliberate. The id alone answers "which row", but following
  /// it gives you the rule as it stands TODAY, which is exactly the thing
  /// every other applied* column exists to avoid: a rule renamed from
  /// "Northport 2026 driver" to "Northport 2027 driver" would silently
  /// relabel last year's vouchers. The frozen name is what a voucher prints;
  /// the id is what an auditor follows.
  ///
  /// Nullable only because rows computed before this column existed cannot be
  /// backfilled honestly — resolution depends on rules and dates as they were,
  /// and guessing would produce a confident wrong answer. Every commission
  /// computed from here on carries both.
  ///
  /// Restrict, like every business foreign key here: a rule that has paid
  /// money is deactivated rather than removed, so the trail stays walkable.
  appliedRuleId   String?         @db.Uuid
  appliedRule     CommissionRule? @relation("CommissionAppliedRule", fields: [appliedRuleId], references: [id], onDelete: Restrict)
  appliedRuleName String?

  /// Frozen copies of the inputs, so a later rate change cannot move this row.
  commissionableBase Decimal @db.Decimal(15, 4)
  amount             Decimal @db.Decimal(15, 4)

  /// The rate this commission was computed at, or reports at.
  ///
  /// For PERCENT_OF_BASE and PERCENT_OF_NET_RATE it is the rule's own rate and
  /// it is an operand: base (or net rate) x this = amount. For the fixed and
  /// formula methods no rate was involved in deriving the amount, so this is a
  /// rate DERIVED afterwards purely so vouchers and reports have one to show —
  /// amount over the base the method conceptually works against.
  ///
  /// Deliberately Decimal(9,4) rather than the (5,4) used for stored
  /// percentages, and deliberately nullable. A derived rate is not a
  /// percentage input and is not bounded by 1: a flat ₱2,000 on a small
  /// backhaul is legitimately 300% of its base. It is null when no honest
  /// figure exists — a zero denominator, or a ratio too large for the column.
  /// Null reads as "not meaningful here"; storing 0 would read as "nothing was
  /// earned", which would be a lie. The amount is always authoritative.
  appliedRate Decimal? @db.Decimal(9, 4)

  /// FORMULA only. The expression as it stood when this row was computed, and
  /// the field values it read, e.g. `{"net_rate":"16200.0000"}`.
  ///
  /// Frozen for the same reason as every other applied* value, but load-bearing
  /// in a way the others are not: a formula is the one method whose logic lives
  /// in editable data, so without the expression the amount is unreproducible
  /// the moment someone edits the rule. Together these two let a reviewer
  /// recompute the figure by hand years later.
  appliedFormulaExpression String?
  appliedFormulaFields     Json?

  computedAt DateTime @default(now()) @db.Timestamptz(6)

  /// IDEMPOTENCY. Nullable until paid.
  ///
  /// This unique is FULL, not partial — the single deliberate exception to the
  /// partial-unique rule. A soft-deleted commission must still count as paid,
  /// so deleting one must never release its payout line and let the same work
  /// be paid twice. Triggers additionally refuse to move or clear this link,
  /// to delete the row, or to soft-delete it, once the run has reached PAID.
  payoutLineId String?     @unique @db.Uuid
  payoutLine   PayoutLine? @relation(fields: [payoutLineId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("CommissionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("CommissionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("CommissionDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([staffId])
  @@index([appliedRuleId])
  @@index([deletedAt])
  @@map("commission")
}

/// A batch payout covering a period. DRAFT -> APPROVED -> PAID.
/// PAID is terminal and immutable; VOIDED is reachable only before PAID.
model PayoutRun {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Partial-unique WHERE "deletedAt" IS NULL.
  runNumber String

  /// Code set: PayoutRunStatus (1 DRAFT, 2 APPROVED, 3 PAID, 4 VOIDED).
  /// PAID is terminal, enforced by trigger.
  status Int @default(1) @db.SmallInt

  periodStart DateTime @db.Timestamptz(6)
  periodEnd   DateTime @db.Timestamptz(6)

  totalGross       Decimal @default(0) @db.Decimal(15, 4)
  totalDeductions  Decimal @default(0) @db.Decimal(15, 4)
  totalAdjustments Decimal @default(0) @db.Decimal(15, 4)
  totalNet         Decimal @default(0) @db.Decimal(15, 4)

  approvedAt     DateTime? @db.Timestamptz(6)
  approvedBy     String?   @db.Uuid
  approvedByUser User?     @relation("PayoutRunApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  paidAt         DateTime? @db.Timestamptz(6)
  paidBy         String?   @db.Uuid
  paidByUser     User?     @relation("PayoutRunPaidBy", fields: [paidBy], references: [id], onDelete: Restrict)
  voidedAt       DateTime? @db.Timestamptz(6)
  voidedBy       String?   @db.Uuid
  voidedByUser   User?     @relation("PayoutRunVoidedBy", fields: [voidedBy], references: [id], onDelete: Restrict)
  voidReason     String?

  lines PayoutLine[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("PayoutRunCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("PayoutRunUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("PayoutRunDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([deletedAt])
  @@map("payout_run")
}

/// One crew member's payment line within a run, carrying exactly one
/// commission plus any deductions and adjustments applied against it.
model PayoutLine {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  payoutRunId String    @db.Uuid
  payoutRun   PayoutRun @relation(fields: [payoutRunId], references: [id], onDelete: Restrict)

  staffId String @db.Uuid
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  /// Back side of Commission.payoutLineId; at most one, by that full unique.
  commission Commission?

  grossAmount      Decimal @db.Decimal(15, 4)
  deductionAmount  Decimal @default(0) @db.Decimal(15, 4)
  adjustmentAmount Decimal @default(0) @db.Decimal(15, 4)
  netAmount        Decimal @db.Decimal(15, 4)

  /// The slices of crew debt this line recovered, itemised. A line may touch
  /// several debts, and a debt may be touched by several lines.
  deductionRecoveries CrewDeductionRecovery[]
  adjustments         Adjustment[]

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("PayoutLineCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("PayoutLineUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("PayoutLineDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([payoutRunId])
  @@index([staffId])
  @@index([deletedAt])
  @@map("payout_line")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

/// Append-only record of who changed what. Distinct from the audit columns:
/// those say who touched a row last, this says what actually changed.
model AuditLog {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  actorId String? @db.Uuid
  actor   User?   @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// e.g. "shipment.dispatch", "liquidation.approve", "payout-run.pay".
  action     String
  entityType String
  entityId   String

  /// Column-level snapshots. Money inside these is serialised as a string.
  before Json?
  after  Json?

  ipAddress  String?
  userAgent  String?
  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  createdBy     String?   @db.Uuid
  createdByUser User?     @relation("AuditLogCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy     String?   @db.Uuid
  updatedByUser User?     @relation("AuditLogUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt     DateTime? @db.Timestamptz(6)
  deletedBy     String?   @db.Uuid
  deletedByUser User?     @relation("AuditLogDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([deletedAt])
  @@map("audit_log")
}
