# EZTruckr — production environment.
#
# YOU DO NOT EDIT THIS FILE ON THE SERVER. It documents the contract; the real
# file at /opt/eztruckr/.env is WRITTEN FROM GITHUB ACTIONS SECRETS on every
# deploy and any hand-edit is overwritten by the next one. To change a value,
# change the secret (Settings → Secrets and variables → Actions) and re-run the
# deploy. That is what keeps "what is running" and "what is configured"
# the same question.
#
# The names below are exactly the GitHub secret names, so the mapping needs no
# translation table. See DEPLOYMENT.md for how to obtain each value.

# --- Identity --------------------------------------------------------------
# The single origin both apps are served from. No scheme, no trailing slash —
# compose and Caddy add "https://" where each needs it.
#
# Set as a github VARIABLE, not a secret: a hostname is public by definition
# and it needs to be readable in build logs to debug a bad NEXT_PUBLIC_API_URL.
APP_DOMAIN=eztruckr.optimuslogisticscorp.com

# --- Images ----------------------------------------------------------------
# Written by the deploy workflow, pinned to the commit SHA rather than a
# floating tag — so `docker compose up -d` on the droplet can never resolve to
# something other than what CI tested, and a rollback is editing one line.
API_IMAGE=ghcr.io/OWNER/eztruckr-api:GITSHA
WEB_IMAGE=ghcr.io/OWNER/eztruckr-web:GITSHA

# --- Database --------------------------------------------------------------
# Postgres runs in a container on this droplet with no published port, so this
# password is not reachable from the internet. It is still the only thing
# between a compromised container and every peso in the system.
#   openssl rand -base64 32
POSTGRES_USER=eztruckr
POSTGRES_DB=eztruckr
POSTGRES_PASSWORD=

# --- Sessions --------------------------------------------------------------
# Signs every session cookie. Rotating it signs everybody out, which is the
# correct move if it ever leaks.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Object storage (Cloudflare R2) ----------------------------------------
# The ACCOUNT-level endpoint, with no bucket name on the end — the SDK appends
# the bucket itself because S3_FORCE_PATH_STYLE is on.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# "auto" is R2's only region. Not us-east-1, whatever the SDK defaults to.
S3_REGION=auto
S3_BUCKET=eztruckr
# From an R2 API token scoped to Object Read & Write on this bucket alone.
# An account-wide token here would let a compromised API container reach every
# bucket in the Cloudflare account.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Outbound mail (Resend) ------------------------------------------------
# NOT OPTIONAL, and the failure mode is total: accounts are activated from an
# emailed link and there is no password anywhere in this repository, so a
# deployment with broken mail is a deployment nobody — including the first
# administrator — can sign in to. Compose refuses to start without both.
RESEND_API_KEY=
# Must be a VERIFIED sender on a domain you own in Resend. The shared
# onboarding@resend.dev sandbox address only delivers to the mailbox that owns
# the Resend account, so it cannot invite staff.
MAIL_FROM=EZTruckr <no-reply@mail.optimuslogisticscorp.com>

# --- Locale ----------------------------------------------------------------
# Storage is UTC everywhere; this is the display zone only.
APP_TIMEZONE=Asia/Manila

# --- Backups ---------------------------------------------------------------
# Nightly pg_dump goes to this bucket. A SEPARATE one from S3_BUCKET on
# purpose: the receipts bucket is written by the application on every upload,
# and backups should not live somewhere the app can overwrite them.
BACKUP_BUCKET=eztruckr-backups
BACKUP_RETENTION_DAYS=30
