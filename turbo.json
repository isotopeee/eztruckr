{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "packages/config/**"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "NEXT_PUBLIC_API_URL",
    "APP_TIMEZONE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "generate": {
      "cache": false
    },

    "@eztruckr/db#test": { "dependsOn": ["^build", "build"], "outputs": [] },
    "@eztruckr/db#typecheck": { "dependsOn": ["^build", "build"], "outputs": [] },
    "@eztruckr/db#lint": { "dependsOn": ["^build", "build"], "outputs": [] }
  }
}
