# Copy to .env for running the apps on your host against the compose services.
# The containerised api/web get their own values from docker-compose.yml.

NODE_ENV=development

# --- API -------------------------------------------------------------------
PORT=4000

# Origins allowed to call the API. Must include wherever the WEB app is served
# from, or the browser blocks every request with a CORS error that looks like
# the API is down. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Deploying somewhere other than this laptop ----------------------------
# Four values are localhost by default, and ALL FOUR have to change together
# for the app to work at a real hostname. Compose reads each from here.
#
#   APP_BASE_URL         where invite links point          (web origin)
#   CORS_ORIGINS         who the API will answer           (web origin)
#   BETTER_AUTH_URL      where session cookies are set     (api origin)
#   NEXT_PUBLIC_API_URL  where the BROWSER calls the API   (api origin)
#
# Change any one alone and the failure is confusing rather than obvious: the
# invite link lands on a page that cannot reach its API, or sign-in succeeds
# and the session evaporates. NEXT_PUBLIC_API_URL is compiled into the client
# bundle, so it needs `docker compose build web`, not just a restart.
#
# Example:
#   APP_BASE_URL=https://eztruckr.optimuslogisticscorp.com
#   CORS_ORIGINS=https://eztruckr.optimuslogisticscorp.com
#   BETTER_AUTH_URL=https://api.eztruckr.optimuslogisticscorp.com
#   NEXT_PUBLIC_API_URL=https://api.eztruckr.optimuslogisticscorp.com/api

# --- Database --------------------------------------------------------------
# Host port 5433 (not 5432) so EZTruckr never collides with another local
# Postgres. Inside the compose network the port is still 5432.
DATABASE_URL=postgresql://eztruckr:eztruckr@localhost:5433/eztruckr?schema=public

# --- Better Auth -----------------------------------------------------------
# REQUIRED. The API refuses to boot without it, and at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- Outbound mail (Resend) ------------------------------------------------
# Every login is created empty and activated from an emailed invite link, so
# without a working transport nobody can sign in to a fresh install. The one
# exception is the fallback below.

# Where invite links point: the WEB origin, NOT the API's. A link built from
# BETTER_AUTH_URL would land the invitee on a JSON 404.
#
# THE DEFAULT ONLY WORKS WHILE YOU ARE THE ONLY INVITEE. localhost resolves on
# whatever machine opens the email, so invite anybody else and they get a link
# to their own laptop — the mail arrives, the link is dead, and nothing says
# why. Set this to a hostname the recipient can reach before inviting anyone.
APP_BASE_URL=http://localhost:3000

# Get one at resend.com. Leave empty to use the log fallback below.
RESEND_API_KEY=

# Must be a VERIFIED sender on the Resend account, or every send 403s.
# The default is Resend's shared sandbox address, which works immediately but
# ONLY delivers to the email that owns your Resend account — fine for trying
# the flow out, useless for inviting anyone else. To invite real people, verify
# a domain (a subdomain is recommended: it isolates this app's sending
# reputation) and set this to an address on it:
#   MAIL_FROM=EZTruckr <no-reply@mail.eztruckr.ph>
MAIL_FROM=EZTruckr <onboarding@resend.dev>

# With no API key, write invite emails — LINK INCLUDED — to the log instead of
# failing. That is how the flow works on a laptop with no Resend account.
#
# DEV ONLY: an invite link in a log file is a credential in a log file. It
# defaults to false so a real deployment that forgets its key gets a loud
# delivery failure rather than a quiet one, and docker-compose turns it on
# explicitly for local work.
#
# It is deliberately NOT derived from NODE_ENV: the compose stack runs
# NODE_ENV=production because it builds the production images, so keying off
# that would disable this in the one place it exists for.
MAIL_LOG_INSTEAD_OF_SENDING=true

# --- Test database ---------------------------------------------------------
# Integration tests run against a SEPARATE database, created and migrated
# automatically on the first `pnpm test`. Derived from DATABASE_URL by adding
# a `_test` suffix when this is unset, so there is usually nothing to do here.
# Whatever it points at gets migrated, seeded and truncated — the tooling
# refuses any name that does not end in `_test`.
# TEST_DATABASE_URL=postgresql://eztruckr:eztruckr@localhost:5433/eztruckr_test?schema=public

# Password for the administrator the SEED creates (admin@eztruckr.ph).
# The seed is the TEST fixture now — it does not run against development, which
# starts empty and is set up through /setup instead. Only matters if you run
# `pnpm db:seed` by hand.
SEED_ADMIN_PASSWORD=eztruckr-dev-admin

# --- Object storage (MinIO in development) ---------------------------------
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=eztruckr
S3_ACCESS_KEY_ID=eztruckr
S3_SECRET_ACCESS_KEY=eztruckr-secret
S3_FORCE_PATH_STYLE=true

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Locale ----------------------------------------------------------------
# Storage is always UTC; this is the display zone.
APP_TIMEZONE=Asia/Manila

# --- Host port mapping for docker compose ----------------------------------
# Override any of these if they clash with something else you run locally.
POSTGRES_PORT=5433
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
API_PORT=4000
WEB_PORT=3000
