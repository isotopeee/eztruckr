# Copy to .env for running the apps on your host against the compose services.
# The containerised api/web get their own values from docker-compose.yml.

NODE_ENV=development

# --- API -------------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Host port 5433 (not 5432) so EZTruckr never collides with another local
# Postgres. Inside the compose network the port is still 5432.
DATABASE_URL=postgresql://eztruckr:eztruckr@localhost:5433/eztruckr?schema=public

# --- Better Auth (Phase 2) -------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- Object storage (MinIO in development) ---------------------------------
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=eztruckr
S3_ACCESS_KEY_ID=eztruckr
S3_SECRET_ACCESS_KEY=eztruckr-secret
S3_FORCE_PATH_STYLE=true

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Locale ----------------------------------------------------------------
# Storage is always UTC; this is the display zone.
APP_TIMEZONE=Asia/Manila

# --- Host port mapping for docker compose ----------------------------------
# Override any of these if they clash with something else you run locally.
POSTGRES_PORT=5433
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
API_PORT=4000
WEB_PORT=3000
